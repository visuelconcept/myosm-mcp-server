{
  "name": "myosm-mcp-server",
  "version": "1.1.0",
  "description": "OpenStreetMap MCP server for Node.js — geocoding, routing, POI discovery and neighborhood analysis tools for LLMs",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "myosm-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "smoke": "node test/smoke.mjs",
    "test": "node test/smoke.mjs && node test/integration.mjs && node test/http.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openstreetmap",
    "osm",
    "geocoding",
    "routing",
    "overpass",
    "nominatim",
    "osrm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visuelconcept/myosm-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "pngjs": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.2"
  }
}
